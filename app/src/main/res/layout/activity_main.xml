<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:orientation="vertical"
    android:padding="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sina TV VPN"
            android:textColor="#F8FAFC"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="● قطع"
            android:textColor="#F87171"
            android:textSize="24sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/activeProfileText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#94A3B8"
        android:textSize="18sp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="340dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="22dp"
        android:background="@drawable/button_bg"
        android:focusable="true"
        android:text="اتصال"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/button_secondary_bg"
            android:focusable="true"
            android:minWidth="170dp"
            android:text="➕ افزودن کانفیگ"
            android:textColor="#F8FAFC"
            android:textSize="19sp" />

        <Button
            android:id="@+id/importFileButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/button_secondary_bg"
            android:focusable="true"
            android:minWidth="170dp"
            android:text="📂 وارد کردن از فایل"
            android:textColor="#F8FAFC"
            android:textSize="19sp" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/button_secondary_bg"
            android:focusable="true"
            android:minWidth="150dp"
            android:text="🗑 حذف انتخاب‌شده"
            android:textColor="#F8FAFC"
            android:textSize="19sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="هنوز کانفیگی نداری.\nلینک کانفیگ (vless / vmess / trojan / ss / hysteria2) رو با «افزودن کانفیگ» وارد کن."
        android:textColor="#64748B"
        android:textSize="20sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
